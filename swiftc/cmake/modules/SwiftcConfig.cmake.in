# This file allows users to call find_package(Swiftc) and pick up our targets.

@SWIFTC_CONFIG_CODE@

set(LLVM_VERSION @LLVM_VERSION_MAJOR@.@LLVM_VERSION_MINOR@.@LLVM_VERSION_PATCH@)
find_package(LLVM ${LLVM_VERSION} EXACT REQUIRED CONFIG
             HINTS "@SWIFTC_CONFIG_LLVM_CMAKE_DIR@")

set(SWIFTC_EXPORTED_TARGETS "@SWIFTC_EXPORTS@")
set(SWIFTC_CMAKE_DIR "@SWIFTC_CONFIG_CMAKE_DIR@")
set(SWIFTC_INCLUDE_DIRS "@SWIFTC_CONFIG_INCLUDE_DIRS@")

# Provide all our library targets to users.
@SWIFTC_CONFIG_INCLUDE_EXPORTS@
